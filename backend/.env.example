# Copie este ficheiro para ".env" e preencha com valores reais.
# NUNCA envie o ficheiro ".env" real para o git.

# Ligação à base de dados PostgreSQL.
# Formato: postgresql://UTILIZADOR:PASSWORD@HOST:PORTA/NOME_DA_BASE
# Se usar o docker-compose.yml incluído, esta ligação já funciona tal como está:
DATABASE_URL="postgresql://apskib:apskib@localhost:5432/apskib?schema=public"

# Porta onde a API vai correr
PORT=4000

# Origem(ns) permitidas a chamar a API (o frontend em desenvolvimento).
# Separe várias origens por vírgula.
CORS_ORIGIN="http://localhost:5173"

# Segredo usado para assinar os tokens JWT de autenticação.
# Gere um valor aleatório forte, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="mude-me-para-um-valor-aleatorio-e-secreto"
JWT_EXPIRES_IN="7d"

# Pasta onde os ficheiros carregados (documentos, imagens, logótipos) são guardados
UPLOAD_DIR="uploads"

# Dados usados pelo "npm run seed" para criar a primeira conta de administrador.
# Mude a password depois do primeiro login.
ADMIN_SEED_NAME="Administrador APSKIB"
ADMIN_SEED_EMAIL="admin@apskib.ao"
ADMIN_SEED_PASSWORD="MudeEstaPassword123!"
